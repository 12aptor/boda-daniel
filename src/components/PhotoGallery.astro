---
// Sección de Galería de Fotos Interactiva con filtros, contador de "Me gusta" y Lightbox modal
const galleryItems = [
  {
    id: 1,
    title: "El Atardecer del Sí",
    category: "propuesta",
    categoryLabel: "La Propuesta",
    date: "Diciembre 2024",
    image: "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80",
    aspect: "aspect-[4/5]",
    description: "La tarde en que prometimos caminar juntos toda la vida frente al mar."
  },
  {
    id: 2,
    title: "Caminos de la Toscana",
    category: "viajes",
    categoryLabel: "Viajes Juntos",
    date: "Junio 2023",
    image: "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=80",
    aspect: "aspect-square",
    description: "Perdiéndonos entre viñedos y descubriendo que cada rincón es especial contigo."
  },
  {
    id: 3,
    title: "Risas Inolvidables",
    category: "preboda",
    categoryLabel: "Sesión Pre-Boda",
    date: "Enero 2026",
    image: "https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1200&q=80",
    aspect: "aspect-[4/5]",
    description: "La complicidad que solo nosotros entendemos y que nos llena el alma."
  },
  {
    id: 4,
    title: "Nuestra Primera Aventura",
    category: "viajes",
    categoryLabel: "Viajes Juntos",
    date: "Agosto 2022",
    image: "https://images.unsplash.com/photo-1469371670807-013ccf25f16a?auto=format&fit=crop&w=1200&q=80",
    aspect: "aspect-[16/10]",
    description: "Aprendiendo a viajar juntos, compartir mochilas y soñar en grande."
  },
  {
    id: 5,
    title: "Detalles que Enamoran",
    category: "preboda",
    categoryLabel: "Sesión Pre-Boda",
    date: "Febrero 2026",
    image: "https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=1200&q=80",
    aspect: "aspect-square",
    description: "Cada mirada sincera que confirma que estamos en el lugar correcto."
  },
  {
    id: 6,
    title: "Promesa Eterna",
    category: "propuesta",
    categoryLabel: "La Propuesta",
    date: "Diciembre 2024",
    image: "https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?auto=format&fit=crop&w=1200&q=80",
    aspect: "aspect-[4/5]",
    description: "El anillo que simboliza una historia sin final."
  }
];

const categories = [
  { key: "todos", label: "Todos los Momentos" },
  { key: "propuesta", label: "La Propuesta" },
  { key: "viajes", label: "Viajes Juntos" },
  { key: "preboda", label: "Sesión Pre-Boda" }
];
---

<section id="galeria" class="py-24 px-4 sm:px-6 relative z-10 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Encabezado -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#132446]/10 border border-[#132446]/20 mb-3">
        <span class="text-[10px] uppercase tracking-[0.25em] text-[#132446] font-semibold">Recuerdos Inolvidables</span>
      </div>
      <h2 class="font-editorial text-3xl sm:text-4xl md:text-5xl text-[#132446] font-normal mb-3">
        Nuestra Galería de Fotos
      </h2>
      <p class="text-sm text-[#64748B] max-w-lg mx-auto font-light">
        Momentos capturados en el tiempo que cuentan el camino que nos trajo hasta este día.
      </p>

      <!-- Filtros de Categorías -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mt-8" id="gallery-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat.key}
            class={`gallery-filter-btn px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all duration-300 cursor-pointer ${
              idx === 0
                ? 'bg-[#132446] text-white shadow-xs'
                : 'bg-white/80 text-[#132446] border border-[#D8CBB9] hover:bg-[#132446]/10'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Grid Editorial / Bento de Fotos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="gallery-grid">
      {galleryItems.map((item) => (
        <div
          class="gallery-item group relative rounded-3xl overflow-hidden bg-white border border-[#D8CBB9]/80 shadow-xs hover:shadow-xl transition-all duration-500 cursor-pointer"
          data-category={item.category}
          data-title={item.title}
          data-description={item.description}
          data-image={item.image}
          data-date={item.date}
        >
          <!-- Contenedor de Imagen -->
          <div class={`relative w-full ${item.aspect} overflow-hidden bg-[#EFE9DF]`}>
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            
            <!-- Overlay con gradiente navy sutil -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#132446]/85 via-[#132446]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6 text-white">
              <span class="text-[10px] uppercase tracking-widest text-[#D4AF37] font-semibold mb-1">
                {item.categoryLabel} · {item.date}
              </span>
              <h3 class="font-editorial text-2xl font-light mb-1">
                {item.title}
              </h3>
              <p class="text-xs text-white/80 line-clamp-2 font-light">
                {item.description}
              </p>

              <!-- Botón flotante para ver en grande -->
              <div class="mt-3 inline-flex items-center gap-1.5 text-xs text-[#D4AF37] font-medium">
                <span>Ampliar foto</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                </svg>
              </div>
            </div>
          </div>

          <!-- Barra inferior de la foto -->
          <div class="p-4 flex items-center justify-between bg-white border-t border-[#D8CBB9]/40">
            <div>
              <h4 class="font-editorial text-lg text-[#132446] font-medium leading-tight">
                {item.title}
              </h4>
              <span class="text-[11px] text-[#64748B]">
                {item.date}
              </span>
            </div>

            <!-- Botón interactivo "Me gusta" con animación de corazón -->
            <button
              type="button"
              class="like-btn p-2 rounded-full hover:bg-[#132446]/5 text-[#64748B] hover:text-[#D4AF37] transition-colors flex items-center gap-1.5 text-xs cursor-pointer"
              aria-label="Dar me gusta a la foto"
            >
              <svg class="w-4 h-4 heart-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
              <span class="like-counter font-medium">12</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- LIGHTBOX MODAL FLOTANTE -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-50 bg-[#132446]/90 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8 transition-opacity duration-300"
>
  <div class="relative max-w-4xl w-full bg-white rounded-3xl overflow-hidden shadow-2xl border border-[#D8CBB9] flex flex-col md:flex-row max-h-[90vh]">
    <!-- Botón Cerrar -->
    <button
      type="button"
      id="lightbox-close-btn"
      class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/80 hover:bg-white text-[#132446] border border-[#D8CBB9] flex items-center justify-center shadow-md cursor-pointer transition-all"
      aria-label="Cerrar vista completa"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Imagen Grande -->
    <div class="w-full md:w-3/5 bg-black flex items-center justify-center overflow-hidden">
      <img
        id="lightbox-img"
        src=""
        alt="Foto de boda en alta resolución"
        class="max-h-[60vh] md:max-h-[80vh] w-full object-contain"
      />
    </div>

    <!-- Panel de Información -->
    <div class="w-full md:w-2/5 p-6 sm:p-8 flex flex-col justify-between bg-white">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#132446]/10 text-[10px] uppercase tracking-widest text-[#132446] font-semibold mb-3" id="lightbox-date">
          Diciembre 2024
        </div>
        <h3 class="font-editorial text-2xl sm:text-3xl text-[#132446] font-medium mb-3" id="lightbox-title">
          Título de la Foto
        </h3>
        <p class="text-sm text-[#64748B] leading-relaxed font-light" id="lightbox-description">
          Descripción del momento especial.
        </p>
      </div>

      <div class="pt-6 border-t border-[#D8CBB9]/60 flex items-center justify-between text-xs text-[#132446]">
        <span class="font-editorial italic text-base">Daniel &amp; Esther</span>
        <span class="text-[#D4AF37]">✦ 19.12.2026 ✦</span>
      </div>
    </div>
  </div>
</div>

<script>
  function setupGallery() {
    // 1. Filtrado interactivo
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const items = document.querySelectorAll('.gallery-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-[#132446]', 'text-white', 'shadow-xs');
          b.classList.add('bg-white/80', 'text-[#132446]', 'border', 'border-[#D8CBB9]');
        });

        btn.classList.add('bg-[#132446]', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-white/80', 'text-[#132446]', 'border', 'border-[#D8CBB9]');

        const filter = btn.getAttribute('data-filter');

        items.forEach(item => {
          const cat = item.getAttribute('data-category');
          if (filter === 'todos' || cat === filter) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 2. Micro-interacción: Me Gusta con pulsación de corazón
    const likeBtns = document.querySelectorAll('.like-btn');
    likeBtns.forEach(btn => {
      let liked = false;
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const icon = btn.querySelector('.heart-icon');
        const counter = btn.querySelector('.like-counter');
        if (!icon || !counter) return;

        let count = parseInt(counter.textContent || '12', 10);

        if (!liked) {
          count++;
          icon.setAttribute('fill', '#D4AF37');
          icon.setAttribute('stroke', '#D4AF37');
          icon.classList.add('scale-125');
          setTimeout(() => icon.classList.remove('scale-125'), 200);
          btn.classList.add('text-[#D4AF37]');
          liked = true;
        } else {
          count--;
          icon.setAttribute('fill', 'none');
          icon.setAttribute('stroke', 'currentColor');
          btn.classList.remove('text-[#D4AF37]');
          liked = false;
        }

        counter.textContent = String(count);
      });
    });

    // 3. Lightbox Modal
    const lightbox = document.getElementById('gallery-lightbox');
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lbTitle = document.getElementById('lightbox-title');
    const lbDesc = document.getElementById('lightbox-description');
    const lbDate = document.getElementById('lightbox-date');
    const closeBtn = document.getElementById('lightbox-close-btn');

    if (lightbox && lbImg && lbTitle && lbDesc && lbDate) {
      items.forEach(item => {
        item.addEventListener('click', () => {
          const imgUrl = item.getAttribute('data-image') || '';
          const title = item.getAttribute('data-title') || '';
          const desc = item.getAttribute('data-description') || '';
          const date = item.getAttribute('data-date') || '';

          lbImg.src = imgUrl;
          lbTitle.textContent = title;
          lbDesc.textContent = desc;
          lbDate.textContent = date;

          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        });
      });

      const closeLightbox = () => {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      };

      closeBtn?.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
          closeLightbox();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGallery);
  } else {
    setupGallery();
  }
</script>
