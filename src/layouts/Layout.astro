---
import "../styles/global.css";
import ClickHeartSparkles from "../components/ClickHeartSparkles.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Daniel & Esther — Nuestra Boda | 19 de Diciembre de 2026",
  description = "Nos casamos y queremos celebrar contigo este día tan especial. Conoce todos los detalles, itinerario y confirma tu asistencia aquí.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-white" style="color-scheme: light; background-color: #FFFFFF !important;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.jpg" />
    
    <!-- Forzar fondo blanco y esquema claro en todos los navegadores/sistemas -->
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="color-scheme" content="light" />

    <!-- Google Fonts: Alex Brush, Great Vibes, Cormorant Garamond, Playfair Display, Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        color-scheme: light !important;
      }
      html, body {
        background-color: #FFFFFF !important;
        background: #FFFFFF !important;
        color-scheme: light !important;
      }
    </style>
  </head>
  <body
    class="bg-white text-[#1E293B] font-sans antialiased selection:bg-[#132446] selection:text-white overflow-x-hidden"
    style="background-color: #FFFFFF !important;"
  >
    <slot />

    <!-- Efecto de corazones crecientes con borde de destellos dorados al hacer click -->
    <ClickHeartSparkles />
  </body>
</html>
