---
import Hero3DCanvas from "./Hero3DCanvas.astro";
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-center text-center px-4 sm:px-6 pt-24 pb-16 overflow-hidden bg-white"
>
  <!-- Fondo y Elementos 3D interactivos con Three.js (pétalos azules, hojas de oro y marfil) -->
  <Hero3DCanvas />

  <!-- Tarjeta Central de Invitación con Marco Doble Dorado de Lujo -->
  <div
    class="relative z-10 max-w-3xl w-full mx-auto p-6 sm:p-12 md:p-16 rounded-3xl invitation-frame bg-white/95 backdrop-blur-md shadow-xl flex flex-col items-center overflow-visible"
  >
    <!-- Ramilletes Florales Completos en Esquinas (100% íntegros, sin cortes y fondo transparente) -->
    <div
      class="absolute -top-5 -right-5 sm:-top-7 sm:-right-7 w-28 sm:w-40 md:w-48 pointer-events-none select-none animate-sway-slow z-20"
      aria-hidden="true"
    >
      <img
        src="/decorations/corner-top-right.webp"
        alt=""
        class="w-full h-auto object-contain drop-shadow-md"
        loading="eager"
      />
    </div>

    <div
      class="absolute -bottom-5 -left-5 sm:-bottom-7 sm:-left-7 w-28 sm:w-40 md:w-48 pointer-events-none select-none animate-sway-reverse z-20"
      aria-hidden="true"
    >
      <img
        src="/decorations/corner-bottom-left.webp"
        alt=""
        class="w-full h-auto object-contain drop-shadow-md"
        loading="eager"
      />
    </div>

    <!-- Encabezado de la Invitación -->
    <p
      class="text-xs sm:text-sm uppercase tracking-[0.25em] text-[#132446] font-medium mb-1.5"
    >
      Nos complace invitarte a:
    </p>

    <!-- Corazón Dorado -->
    <div class="text-[#D4AF37] text-sm mb-3">💛</div>

    <!-- Título 'Nuestra Boda' en caligrafía dorada de lujo -->
    <h2
      class="font-calligraphy text-4xl sm:text-6xl md:text-7xl text-[#D4AF37] leading-tight mb-1 font-normal tracking-wide drop-shadow-xs"
    >
      Nuestra Boda
    </h2>

    <!-- Nombres Principales en Caligrafía Azul Noche 'Daniel & Esther' -->
    <h1
      class="font-script text-5xl sm:text-7xl md:text-8xl lg:text-9xl text-[#132446] leading-none mb-4 font-normal tracking-wide"
    >
      Daniel &amp; Esther
    </h1>

    <!-- Cita Ecos Poéticos de la Invitación -->
    <p
      class="font-editorial italic text-base sm:text-lg md:text-xl text-[#132446]/85 max-w-xl mx-auto mb-5 font-light leading-relaxed"
    >
      "En este día tan especial, queremos compartir con personas muy importantes en nuestras vidas."
    </p>

    <!-- Icono de Alianzas de Boda -->
    <div class="mb-5 flex flex-col items-center">
      <img
        src="/ring.webp"
        alt="Alianzas de boda"
        class="w-24 h-24 sm:w-28 sm:h-28 object-contain filter drop-shadow-md select-none pointer-events-none animate-float-delicate"
        loading="eager"
      />
    </div>

    <!-- Divisor Floral con Corazón Dorado -->
    <div class="flex items-center justify-center gap-3 text-[#D4AF37] mb-6 w-full max-w-xs">
      <span class="h-[1px] flex-1 bg-gradient-to-r from-transparent to-[#D4AF37]"></span>
      <span class="text-xs text-[#D4AF37]">✦ 💛 ✦</span>
      <span class="h-[1px] flex-1 bg-gradient-to-l from-transparent to-[#D4AF37]"></span>
    </div>

    <!-- Información de Fecha y Sede con Borde Dorado -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6 text-xs sm:text-sm uppercase tracking-[0.2em] text-[#132446] font-semibold mb-8 py-3.5 px-8 rounded-full bg-white border-2 border-[#D4AF37] shadow-xs"
    >
      <span class="flex items-center gap-2">
        <svg
          class="w-4 h-4 text-[#D4AF37]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        DICIEMBRE 19 2026
      </span>
      <span class="hidden sm:inline text-[#D4AF37]">✦</span>
      <span class="flex items-center gap-2">
        <svg
          class="w-4 h-4 text-[#D4AF37]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
          ></path>
        </svg>
        IEP Garcilaso · Cusco, Perú
      </span>
    </div>

    <!-- Botones de Acción con Bordes Dorados de Lujo -->
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
      <a
        href="#rsvp"
        class="btn-gold w-full sm:w-auto px-9 py-4 rounded-full text-xs uppercase tracking-[0.2em] font-semibold text-center"
      >
        Confirmar Asistencia
      </a>
      <a
        href="#itinerario"
        class="btn-gold-light w-full sm:w-auto px-8 py-4 rounded-full text-xs uppercase tracking-[0.2em] font-semibold text-center"
      >
        Ver Itinerario
      </a>
    </div>

    <!-- Cierre '¡Te esperamos!' -->
    <p class="font-calligraphy text-2xl sm:text-3xl text-[#132446] mt-6 font-normal">
      ¡Te esperamos!
    </p>
  </div>
</section>
