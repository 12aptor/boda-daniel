---
// Decoraciones botánicas globales con rosas azules acuarela y hojas doradas
// Micro-animaciones suaves y elegantes inspiradas en la tarjeta de invitación nupcial
---

<!-- Decoraciones Botánicas y Pétalos Flotantes Ambientales -->
<div class="pointer-events-none fixed inset-0 z-20 overflow-hidden" aria-hidden="true">

  <!-- Ramitas Doradas Delicadas en los laterales (100% transparentes) -->
  <div
    class="absolute top-1/3 -left-8 sm:-left-10 md:-left-12 w-28 sm:w-36 md:w-48 opacity-70 animate-sway-slow select-none pointer-events-none"
  >
    <img
      src="/decorations/gold-branch.webp"
      alt=""
      class="w-full h-auto object-contain transform -rotate-12"
      loading="lazy"
    />
  </div>

  <div
    class="absolute top-2/3 -right-8 sm:-right-10 md:-right-12 w-28 sm:w-36 md:w-48 opacity-70 animate-sway-reverse select-none pointer-events-none"
  >
    <img
      src="/decorations/gold-branch.webp"
      alt=""
      class="w-full h-auto object-contain transform rotate-180 scale-x-[-1]"
      loading="lazy"
    />
  </div>

  <!-- Canvas de pétalos azules y partículas doradas flotantes muy suaves -->
  <canvas
    id="floral-floating-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none opacity-70"
  ></canvas>
</div>

<script>
  function initFloralAmbient() {
    const canvas = document.getElementById('floral-floating-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    function onResize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }

    window.addEventListener('resize', onResize, { passive: true });

    // Partículas botánicas naturales: hojas lanceoladas doradas, pétalos de rosa azul y destellos estrella
    const count = window.innerWidth < 768 ? 16 : 28;

    interface Particle {
      x: number;
      y: number;
      size: number;
      speedY: number;
      swaySpeed: number;
      swayDist: number;
      swayOffset: number;
      rotation: number;
      rotSpeed: number;
      type: 'bluePetal' | 'goldLeaf' | 'goldSparkle';
      opacity: number;
    }

    const particles: Particle[] = [];

    const types: ('bluePetal' | 'goldLeaf' | 'goldSparkle')[] = [
      'bluePetal',
      'bluePetal',
      'goldLeaf',
      'goldSparkle'
    ];

    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 4.5 + 4,
        speedY: Math.random() * 0.45 + 0.25, // Caída serena y lenta
        swaySpeed: Math.random() * 0.015 + 0.008,
        swayDist: Math.random() * 25 + 15,
        swayOffset: Math.random() * Math.PI * 2,
        rotation: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.012,
        type: types[Math.floor(Math.random() * types.length)],
        opacity: Math.random() * 0.35 + 0.5
      });
    }

    // Dibuja una hoja botánica realista con peciolo/tallo, punta lanceolada, nervadura central y secundarias
    function drawBotanicalLeaf(ctx: CanvasRenderingContext2D, size: number, opacity: number) {
      const length = size * 2.3;
      const halfW = size * 0.95;
      const stemLen = size * 0.55;

      // 1. Peciolo / tallo
      ctx.beginPath();
      ctx.moveTo(0, length);
      ctx.lineTo(0, length + stemLen);
      ctx.strokeStyle = `rgba(180, 140, 45, ${opacity * 0.85})`;
      ctx.lineWidth = Math.max(0.7, size * 0.12);
      ctx.stroke();

      // 2. Silueta orgánica de la hoja con punta aguda y márgenes curvos
      ctx.beginPath();
      ctx.moveTo(0, length); // Base
      ctx.bezierCurveTo(halfW * 0.85, length * 0.6, halfW * 1.25, -length * 0.2, 0, -length); // Punta afilada
      ctx.bezierCurveTo(-halfW * 1.25, -length * 0.2, -halfW * 0.85, length * 0.6, 0, length); // Lado izquierdo
      ctx.closePath();

      // Relleno degradado dorado metálico
      const grad = ctx.createLinearGradient(0, length, 0, -length);
      grad.addColorStop(0, `rgba(195, 155, 55, ${opacity * 0.9})`);
      grad.addColorStop(0.5, `rgba(235, 205, 110, ${opacity})`);
      grad.addColorStop(1, `rgba(212, 175, 55, ${opacity * 0.85})`);
      ctx.fillStyle = grad;
      ctx.fill();

      // Borde dorado fino
      ctx.strokeStyle = `rgba(255, 235, 160, ${opacity * 0.75})`;
      ctx.lineWidth = 0.6;
      ctx.stroke();

      // 3. Nervadura central
      ctx.beginPath();
      ctx.moveTo(0, length);
      ctx.quadraticCurveTo(halfW * 0.06, 0, 0, -length * 0.94);
      ctx.strokeStyle = `rgba(255, 245, 190, ${opacity * 0.85})`;
      ctx.lineWidth = Math.max(0.7, size * 0.09);
      ctx.stroke();

      // 4. Nervaduras laterales secundarias
      const veins = [
        { y: length * 0.5, spanX: halfW * 0.6, reachY: length * 0.2 },
        { y: length * 0.1, spanX: halfW * 0.8, reachY: -length * 0.2 },
        { y: -length * 0.3, spanX: halfW * 0.55, reachY: -length * 0.6 }
      ];

      ctx.lineWidth = 0.45;
      ctx.strokeStyle = `rgba(255, 245, 190, ${opacity * 0.55})`;
      veins.forEach((v) => {
        // Derecha
        ctx.beginPath();
        ctx.moveTo(0, v.y);
        ctx.quadraticCurveTo(v.spanX * 0.5, (v.y + v.reachY) * 0.5, v.spanX, v.reachY);
        ctx.stroke();
        // Izquierda
        ctx.beginPath();
        ctx.moveTo(0, v.y);
        ctx.quadraticCurveTo(-v.spanX * 0.5, (v.y + v.reachY) * 0.5, -v.spanX, v.reachY);
        ctx.stroke();
      });
    }

    // Dibuja un pétalo de rosa auténtico con hendidura superior acorazonada y base estrecha
    function drawRosePetal(ctx: CanvasRenderingContext2D, size: number, opacity: number) {
      const h = size * 2.0;
      const w = size * 1.45;

      const grad = ctx.createRadialGradient(0, h * 0.3, 0, 0, 0, h);
      grad.addColorStop(0, `rgba(145, 180, 205, ${opacity * 0.95})`);
      grad.addColorStop(0.65, `rgba(100, 140, 172, ${opacity * 0.85})`);
      grad.addColorStop(1, `rgba(30, 58, 102, ${opacity * 0.75})`);

      // Silueta con dos lóbulos superiores redondeados y hendidura central
      ctx.beginPath();
      ctx.moveTo(0, h); // Base estrecha
      ctx.bezierCurveTo(w * 0.7, h * 0.6, w * 1.15, -h * 0.15, w * 0.55, -h * 0.8);
      ctx.bezierCurveTo(w * 0.25, -h * 0.7, 0, -h * 0.55, 0, -h * 0.5); // Hendidura de corazón
      ctx.bezierCurveTo(0, -h * 0.55, -w * 0.25, -h * 0.7, -w * 0.55, -h * 0.8);
      ctx.bezierCurveTo(-w * 1.15, -h * 0.15, -w * 0.7, h * 0.6, 0, h);
      ctx.closePath();

      ctx.fillStyle = grad;
      ctx.fill();

      // Borde del pétalo
      ctx.strokeStyle = `rgba(30, 58, 102, ${opacity * 0.35})`;
      ctx.lineWidth = 0.55;
      ctx.stroke();

      // Vetas internas sutiles
      ctx.beginPath();
      ctx.moveTo(0, h * 0.85);
      ctx.quadraticCurveTo(w * 0.18, 0, w * 0.32, -h * 0.55);
      ctx.moveTo(0, h * 0.85);
      ctx.quadraticCurveTo(-w * 0.18, 0, -w * 0.32, -h * 0.55);
      ctx.strokeStyle = `rgba(255, 255, 255, ${opacity * 0.35})`;
      ctx.lineWidth = 0.4;
      ctx.stroke();
    }

    // Dibuja una estrella dorada radiante de 4 puntas cóncavas (destello estelar, nunca un círculo)
    function drawStarSparkle(ctx: CanvasRenderingContext2D, size: number, opacity: number) {
      const r = size * 1.1;
      ctx.fillStyle = `rgba(212, 175, 55, ${opacity * 0.95})`;
      ctx.beginPath();
      ctx.moveTo(0, -r);
      ctx.quadraticCurveTo(0, 0, r, 0);
      ctx.quadraticCurveTo(0, 0, 0, r);
      ctx.quadraticCurveTo(0, 0, -r, 0);
      ctx.quadraticCurveTo(0, 0, 0, -r);
      ctx.closePath();
      ctx.fill();

      // Centro blanco dorado
      ctx.fillStyle = `rgba(255, 250, 220, ${opacity})`;
      ctx.beginPath();
      ctx.arc(0, 0, r * 0.25, 0, Math.PI * 2);
      ctx.fill();
    }

    let time = 0;

    function render() {
      ctx?.clearRect(0, 0, width, height);
      time += 0.02;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.y += p.speedY;
        p.rotation += p.rotSpeed;

        const sway = Math.sin(time * p.swaySpeed + p.swayOffset) * p.swayDist;
        const currentX = (p.x + sway + width) % width;

        if (p.y > height + 25) {
          p.y = -25;
          p.x = Math.random() * width;
        }

        ctx?.save();
        ctx?.translate(currentX, p.y);
        ctx?.rotate(p.rotation);

        if (p.type === 'bluePetal') {
          drawRosePetal(ctx, p.size, p.opacity);
        } else if (p.type === 'goldLeaf') {
          drawBotanicalLeaf(ctx, p.size, p.opacity);
        } else {
          drawStarSparkle(ctx, p.size, p.opacity);
        }

        ctx?.restore();
      }

      requestAnimationFrame(render);
    }

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloralAmbient);
  } else {
    initFloralAmbient();
  }
</script>
