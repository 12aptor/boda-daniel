---
// Barra de navegación flotante minimalista con efecto glassmorphism y color principal #132446
---

<header
  class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-8 py-4 transition-all duration-300 pointer-events-none"
  id="site-header"
>
  <div
    class="max-w-6xl mx-auto flex items-center justify-between pointer-events-auto"
  >
    <!-- Monograma / Logo -->
    <a
      href="#hero"
      class="group flex items-center gap-2 bg-white/95 hover:bg-white backdrop-blur-md px-4 py-2 rounded-full border border-[#D4AF37]/60 shadow-xs transition-all duration-300"
    >
      <span
        class="font-script text-xl tracking-wider text-[#132446] font-semibold group-hover:text-[#D4AF37] transition-colors"
        >D &amp; E</span
      >
      <span
        class="text-xs uppercase tracking-widest text-[#64748B] hidden sm:inline"
        >· 19.12.26</span
      >
    </a>

    <!-- Menú de Enlaces Flotantes en Desktop -->
    <nav
      class="hidden md:flex items-center gap-1 bg-white/95 backdrop-blur-md px-4 py-1.5 rounded-full border border-[#D4AF37]/40 shadow-xs text-xs uppercase tracking-widest text-[#132446]/85 font-medium"
    >
      <a
        href="#countdown"
        class="px-3 py-1.5 rounded-full hover:text-[#132446] hover:bg-[#132446]/5 transition-colors"
        >Cuenta Regresiva</a
      >
      <a
        href="#historia"
        class="px-3 py-1.5 rounded-full hover:text-[#132446] hover:bg-[#132446]/5 transition-colors"
        >Historia</a
      >
      <a
        href="#itinerario"
        class="px-3 py-1.5 rounded-full hover:text-[#132446] hover:bg-[#132446]/5 transition-colors"
        >Itinerario</a
      >
      <a
        href="#dresscode"
        class="px-3 py-1.5 rounded-full hover:text-[#132446] hover:bg-[#132446]/5 transition-colors"
        >Dress Code</a
      >
      <a
        href="#regalos"
        class="px-3 py-1.5 rounded-full hover:text-[#132446] hover:bg-[#132446]/5 transition-colors"
        >Regalos</a
      >
    </nav>

    <!-- Botón directo RSVP con Borde Dorado -->
    <a
      href="#rsvp"
      class="btn-gold text-xs uppercase tracking-widest px-5 py-2.5 rounded-full font-semibold"
    >
      Confirmar RSVP
    </a>
  </div>
</header>
