---
// Confirmación de Asistencia (RSVP) con enlace a Google Forms y diseño de alta costura
const googleFormsUrl =
  "https://docs.google.com/forms/d/e/1FAIpQLSf4E5G9zIXGfAiKBmKHe-CULmgifgGsYfUqnz9-XmcbCTW42Q/viewform?usp=publish-editor";
---

<section id="rsvp" class="py-24 px-4 sm:px-6 relative z-10 bg-transparent">
  <div class="max-w-3xl mx-auto">
    <!-- Encabezado Editorial -->
    <div class="text-center mb-14">
      <div
        class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-[#0E1B33]/5 border border-[#D4AF37]/35 mb-4"
      >
        <span
          class="text-xs sm:text-sm uppercase tracking-[0.25em] text-[#0E1B33] font-semibold"
          >Responde Por Favor · RSVP</span
        >
      </div>

      <h2
        class="font-editorial text-4xl sm:text-6xl md:text-7xl font-light text-[#0E1B33] tracking-wide mb-2"
      >
        Confirmación de Asistencia
      </h2>

      <div class="h-[1px] w-16 bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent mx-auto mb-4"></div>

      <p class="font-editorial italic text-lg sm:text-xl text-[#5A6A85] max-w-lg mx-auto font-light leading-relaxed">
        Agradecemos confirmar tu asistencia antes del <strong class="text-[#0E1B33] font-medium">19 de Diciembre de 2026</strong> para coordinar cada detalle de la recepción.
      </p>
    </div>

    <!-- Tarjeta Elegante con Marco Doble Dorado de Invitación -->
    <div
      class="p-8 sm:p-14 rounded-3xl bg-white/95 invitation-frame shadow-2xl text-center max-w-xl mx-auto relative overflow-hidden"
    >
      <div
        class="w-16 h-16 rounded-full bg-[#FCFBF7] border border-[#D4AF37]/50 text-[#D4AF37] flex items-center justify-center mx-auto mb-6 shadow-xs ring-4 ring-[#D4AF37]/10"
      >
        <svg class="w-7 h-7 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
      </div>

      <h3
        class="font-editorial text-3xl sm:text-4xl text-[#0E1B33] font-normal mb-3"
      >
        Tu Presencia es Nuestro Mayor Regalo
      </h3>

      <p class="font-editorial italic text-base sm:text-lg text-[#5A6A85] leading-relaxed mb-8 font-light">
        Por favor haz clic en el siguiente enlace para completar el formulario oficial con tus datos y pases de asistencia.
      </p>

      <!-- Botón con Borde Dorado de Lujo -->
      <a
        href={googleFormsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-gold w-full sm:w-auto inline-flex items-center justify-center gap-3 py-4 px-10 rounded-full text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold group"
      >
        <span>Llenar Formulario de Asistencia</span>
        <svg
          class="w-4 h-4 transform group-hover:translate-x-1 transition-transform text-[#D4AF37]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>

      <div
        class="mt-8 pt-6 border-t border-[#D4AF37]/25 flex items-center justify-center gap-2 text-xs sm:text-sm text-[#5A6A85]"
      >
        <span class="text-[#D4AF37]">✦</span>
        <span>Formulario oficial en Google Forms</span>
        <span class="text-[#D4AF37]">✦</span>
      </div>
    </div>
  </div>
</section>
