---
// Mesa de Regalos
const storeRegistries = [
  {
    store: "Liverpool",
    eventNumber: "51284930",
    url: "https://mesaderegalos.liverpool.com.mx/",
    badge: "Mesa Departamental",
    icon: "🛍️",
  },
  {
    store: "Amazon Bodas",
    eventNumber: "Daniel & Esther Wedding",
    url: "https://www.amazon.com.mx/baby-reg/",
    badge: "Envío a Domicilio",
    icon: "📦",
  },
];
---

<section id="regalos" class="py-24 px-4 sm:px-6 relative z-10 bg-white">
  <div class="max-w-4xl mx-auto">
    <!-- Encabezado con Caligrafía Dorada -->
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#132446]/5 border border-[#D4AF37]/40 mb-2"
      >
        <span
          class="text-[10px] uppercase tracking-[0.25em] text-[#132446] font-semibold"
          >Muestra de Afecto</span
        >
      </div>
      <h2
        class="font-calligraphy text-4xl sm:text-6xl md:text-7xl text-[#D4AF37] font-normal mb-1"
      >
        Mesa de Regalos
      </h2>
      <div class="text-[#D4AF37] text-xs mb-3">💛</div>
      <p class="text-sm text-[#64748B] max-w-lg mx-auto font-light">
        El mejor regalo es tu presencia y compartir con nosotros este día. Si
        deseas tener un detalle para nuestro nuevo hogar o luna de miel, ponemos
        a tu disposición las siguientes opciones:
      </p>
    </div>

    <!-- Opción de Regalos Centrada con Marco de Invitación -->
    <div class="max-w-xl mx-auto mb-12">
      <!-- Tarjeta: Tiendas Departamentales -->
      <div
        class="p-8 sm:p-10 rounded-3xl bg-white invitation-frame shadow-md flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">🎁</span>
            <span
              class="text-[10px] uppercase tracking-[0.2em] font-semibold text-[#D4AF37] bg-white border border-[#D4AF37]/60 px-3 py-1 rounded-full"
            >
              Mesa Departamental
            </span>
          </div>

          <h3 class="font-editorial text-2xl text-[#132446] font-medium mb-1">
            Artículos para el Hogar
          </h3>
          <p class="text-xs text-[#64748B] mb-6 font-light">
            Si prefieres obsequiarnos algún artículo seleccionado para nuestra
            casa.
          </p>

          <div class="space-y-4">
            {
              storeRegistries.map((reg) => (
                <div class="p-4 rounded-2xl bg-white border border-[#D4AF37]/50 ring-1 ring-[#D4AF37]/20 shadow-xs flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">{reg.icon}</span>
                    <div>
                      <h4 class="font-semibold text-sm text-[#132446]">
                        {reg.store}
                      </h4>
                      <span class="text-xs text-[#64748B]">
                        Evento:{" "}
                        <strong class="text-[#132446]">
                          {reg.eventNumber}
                        </strong>
                      </span>
                    </div>
                  </div>
                  <a
                    href={reg.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-gold-light px-3.5 py-1.5 rounded-full text-[11px] font-semibold uppercase tracking-wider flex items-center gap-1"
                  >
                    Ver Mesa
                    <svg
                      class="w-3.5 h-3.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </a>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Opción de Lluvia de Sobres -->
        <div
          class="mt-6 p-4 rounded-2xl bg-[#EFE9DF]/50 border border-[#D8CBB9]/50 text-center"
        >
          <p class="text-xs text-[#64748B]">
            💌 <strong class="text-[#132446]">Lluvia de Sobres:</strong> También dispondremos
            de un buzón en la recepción para recibir tus buenos deseos de forma personal.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
