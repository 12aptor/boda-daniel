---
// Barra de navegación flotante de alta costura con cristal nupcial y detalles en oro imperial
---

<header
  class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-8 py-4 transition-all duration-300 pointer-events-none"
  id="site-header"
>
  <div
    class="max-w-6xl mx-auto flex items-center justify-between pointer-events-auto"
  >
    <!-- Monograma Real / Logo -->
    <a
      href="#hero"
      class="group flex items-center gap-2.5 bg-white/95 hover:bg-white backdrop-blur-md px-4 py-2 rounded-full border border-[#D4AF37]/50 shadow-sm transition-all duration-300 hover:shadow-md hover:border-[#D4AF37]"
    >
      <span
        class="font-editorial italic text-lg tracking-widest text-[#0E1B33] font-normal group-hover:text-[#D4AF37] transition-colors flex items-center"
      >
        D <span class="font-ampersand text-[#D4AF37] text-base mx-1">&amp;</span
        > E
      </span>
      <span
        class="text-xs uppercase tracking-[0.2em] text-[#5A6A85] hidden sm:inline"
        >· 19.12.26</span
      >
    </a>

    <!-- Menú de Enlaces Flotantes en Desktop -->
    <nav
      class="hidden md:flex items-center gap-2 bg-white/95 backdrop-blur-md px-6 py-2 rounded-full border border-[#D4AF37]/35 shadow-sm text-xs uppercase tracking-[0.18em] text-[#0E1B33]/85 font-semibold"
    >
      <a
        href="#countdown"
        class="px-3.5 py-1.5 rounded-full hover:text-[#0E1B33] hover:bg-[#0E1B33]/5 transition-colors"
        >Cuenta Regresiva</a
      >
      <a
        href="#padres-padrinos"
        class="px-3.5 py-1.5 rounded-full hover:text-[#0E1B33] hover:bg-[#0E1B33]/5 transition-colors"
        >Padres &amp; Padrinos</a
      >
      <a
        href="#itinerario"
        class="px-3.5 py-1.5 rounded-full hover:text-[#0E1B33] hover:bg-[#0E1B33]/5 transition-colors"
        >Itinerario</a
      >
      <a
        href="#dresscode"
        class="px-3.5 py-1.5 rounded-full hover:text-[#0E1B33] hover:bg-[#0E1B33]/5 transition-colors"
        >Dress Code</a
      >
    </nav>

    <!-- Botón directo RSVP con Acabado de Lujo -->
    <a
      href="#rsvp"
      class="btn-gold text-xs uppercase tracking-[0.2em] px-6 py-2.5 rounded-full font-semibold"
    >
      Confirmar RSVP
    </a>
  </div>
</header>
