---
// Hero Section Principal de Alta Costura Nupcial
// Inspirado en editoriales de bodas de lujo: Vogue Weddings, Cartier & Harper's Bazaar Bride
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-center text-center px-4 sm:px-6 pt-24 pb-16 bg-transparent"
>
  <!-- Tarjeta Central de Invitación de Alta Costura con Doble Filete de Oro -->
  <div
    class="relative z-10 max-w-3xl w-full mx-auto p-8 sm:p-14 md:p-18 rounded-3xl invitation-frame bg-white/95 backdrop-blur-md shadow-2xl flex flex-col items-center overflow-visible"
  >
    <!-- Ramilletes Florales Completos en Esquinas (con transparencia total) -->
    <div
      class="absolute -top-5 -right-5 sm:-top-7 sm:-right-7 w-28 sm:w-40 md:w-48 pointer-events-none select-none animate-sway-slow z-20"
      aria-hidden="true"
    >
      <img
        src="/decorations/corner-top-right.webp"
        alt=""
        class="w-full h-auto object-contain drop-shadow-md"
        loading="eager"
      />
    </div>

    <div
      class="absolute -bottom-5 -left-5 sm:-bottom-7 sm:-left-7 w-28 sm:w-40 md:w-48 pointer-events-none select-none animate-sway-reverse z-20"
      aria-hidden="true"
    >
      <img
        src="/decorations/corner-bottom-left.webp"
        alt=""
        class="w-full h-auto object-contain drop-shadow-md"
        loading="eager"
      />
    </div>

    <!-- Encabezado de la Invitación Real -->
    <p
      class="text-xs sm:text-sm uppercase tracking-[0.25em] text-[#5A6A85] font-semibold mb-2"
    >
      Nos complace invitarte a la celebración de
    </p>

    <!-- Título 'Nuestra Boda' en caligrafía dorada de lujo -->
    <h2
      class="font-calligraphy text-4xl sm:text-6xl md:text-7xl gold-foil-text leading-tight mb-1 font-normal tracking-wide"
    >
      Nuestra Boda
    </h2>

    <!-- Nombres Principales en Caligrafía Azul Noche 'Daniel & Esther' con ampersand en oro -->
    <h1
      class="font-script text-6xl sm:text-8xl md:text-9xl text-[#0E1B33] leading-none mb-4 font-normal tracking-wide flex items-center justify-center flex-wrap gap-x-3"
    >
      <span>Daniel</span>
      <span class="font-ampersand gold-foil-text text-[0.8em] sm:text-[0.85em] font-light leading-none px-1 inline-block drop-shadow-xs">&amp;</span>
      <span>Esther</span>
    </h1>

    <!-- Cita Ecos Poéticos de la Invitación -->
    <p
      class="font-editorial italic text-lg sm:text-xl md:text-2xl text-[#0E1B33]/85 max-w-2xl mx-auto mb-6 font-light leading-relaxed"
    >
      "En este día tan esperado, queremos compartir la bendición de nuestra unión con las personas más importantes de nuestras vidas."
    </p>

    <!-- Alianzas de Boda -->
    <div class="mb-6 flex flex-col items-center">
      <img
        src="/ring.webp"
        alt="Alianzas de boda"
        class="w-24 h-24 sm:w-28 sm:h-28 object-contain filter drop-shadow-md select-none pointer-events-none animate-float-delicate"
        loading="eager"
      />
    </div>

    <!-- Divisor Floral con destellos de oro -->
    <div
      class="flex items-center justify-center gap-3 text-[#D4AF37] mb-8 w-full max-w-xs"
    >
      <span
        class="h-[1px] flex-1 bg-gradient-to-r from-transparent to-[#D4AF37]"
      ></span>
      <span class="text-xs text-[#D4AF37] tracking-[0.3em]">✦ ✦ ✦</span>
      <span
        class="h-[1px] flex-1 bg-gradient-to-l from-transparent to-[#D4AF37]"
      ></span>
    </div>

    <!-- Información de Fecha y Sede con Borde Dorado -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6 text-sm sm:text-base uppercase tracking-[0.14em] text-[#0E1B33] font-semibold mb-10 py-3.5 px-7 sm:px-9 rounded-2xl sm:rounded-full bg-white border border-[#D4AF37]/60 shadow-xs max-w-full"
    >
      <span class="flex items-center gap-2.5 whitespace-nowrap">
        <svg
          class="w-4 h-4 text-[#D4AF37] shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        <span>19 Diciembre 2026 · 10:00 AM</span>
      </span>

      <span class="hidden sm:inline text-[#D4AF37]">✦</span>

      <span class="flex items-center gap-2.5 whitespace-nowrap">
        <svg
          class="w-4 h-4 text-[#D4AF37] shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>IEP Cusco</span>
      </span>
    </div>

    <!-- Botones de Acción con Acabado de Lujo -->
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
      <a
        href="#rsvp"
        class="btn-gold w-full sm:w-auto px-10 py-4 rounded-full text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-center"
      >
        Confirmar Asistencia
      </a>
      <a
        href="#itinerario"
        class="btn-gold-light w-full sm:w-auto px-9 py-4 rounded-full text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-center"
      >
        Ver Itinerario
      </a>
    </div>

    <!-- Cierre '¡Te esperamos!' -->
    <p
      class="font-calligraphy text-3xl sm:text-4xl text-[#0E1B33] mt-8 font-normal"
    >
      ¡Te esperamos con ilusión!
    </p>
  </div>
</section>
