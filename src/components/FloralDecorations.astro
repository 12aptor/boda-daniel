---
// Decoraciones botánicas globales con rosas azules acuarela y hojas doradas
// Micro-animaciones suaves y elegantes inspiradas en la tarjeta de invitación nupcial
---

<!-- Decoraciones Botánicas y Pétalos Flotantes Ambientales -->
<div class="pointer-events-none fixed inset-0 z-20 overflow-hidden" aria-hidden="true">

  <!-- Ramitas Doradas Delicadas en los laterales (Desktop) -->
  <div
    class="hidden xl:block absolute top-1/3 -left-12 w-48 opacity-60 animate-sway-slow select-none"
  >
    <img
      src="/decorations/gold-branch.webp"
      alt=""
      class="w-full h-auto object-contain transform -rotate-12"
      loading="lazy"
    />
  </div>

  <div
    class="hidden xl:block absolute top-2/3 -right-12 w-48 opacity-60 animate-sway-reverse select-none"
  >
    <img
      src="/decorations/gold-branch.webp"
      alt=""
      class="w-full h-auto object-contain transform rotate-180 scale-x-[-1]"
      loading="lazy"
    />
  </div>

  <!-- Canvas de pétalos azules y partículas doradas flotantes muy suaves -->
  <canvas
    id="floral-floating-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none opacity-70"
  ></canvas>
</div>

<script>
  function initFloralAmbient() {
    const canvas = document.getElementById('floral-floating-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    function onResize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }

    window.addEventListener('resize', onResize, { passive: true });

    // Partículas muy suaves: pétalos de rosa azul y hojas/brillos dorados
    // Cantidad reducida para que nunca sea ruidoso
    const count = window.innerWidth < 768 ? 16 : 28;

    interface Particle {
      x: number;
      y: number;
      size: number;
      speedY: number;
      swaySpeed: number;
      swayDist: number;
      swayOffset: number;
      rotation: number;
      rotSpeed: number;
      type: 'bluePetal' | 'goldLeaf' | 'goldSparkle';
      opacity: number;
    }

    const particles: Particle[] = [];

    const types: ('bluePetal' | 'goldLeaf' | 'goldSparkle')[] = [
      'bluePetal',
      'bluePetal',
      'goldLeaf',
      'goldSparkle'
    ];

    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 5 + 3.5,
        speedY: Math.random() * 0.45 + 0.25, // Caída muy serena y lenta
        swaySpeed: Math.random() * 0.015 + 0.008,
        swayDist: Math.random() * 25 + 15,
        swayOffset: Math.random() * Math.PI * 2,
        rotation: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.012,
        type: types[Math.floor(Math.random() * types.length)],
        opacity: Math.random() * 0.35 + 0.45
      });
    }

    let time = 0;

    function render() {
      ctx?.clearRect(0, 0, width, height);
      time += 0.02;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.y += p.speedY;
        p.rotation += p.rotSpeed;

        const sway = Math.sin(time * p.swaySpeed + p.swayOffset) * p.swayDist;
        const currentX = (p.x + sway + width) % width;

        if (p.y > height + 20) {
          p.y = -20;
          p.x = Math.random() * width;
        }

        ctx?.save();
        ctx?.translate(currentX, p.y);
        ctx?.rotate(p.rotation);

        if (p.type === 'bluePetal') {
          // Pétalo de rosa azul acuarela
          ctx.fillStyle = `rgba(107, 143, 168, ${p.opacity})`;
          ctx.beginPath();
          ctx.ellipse(0, 0, p.size * 1.4, p.size * 0.8, 0, 0, Math.PI * 2);
          ctx.fill();

          // Sombra suave en borde
          ctx.strokeStyle = `rgba(30, 58, 102, ${p.opacity * 0.4})`;
          ctx.lineWidth = 0.6;
          ctx.stroke();
        } else if (p.type === 'goldLeaf') {
          // Hoja dorada metálica
          ctx.fillStyle = `rgba(212, 175, 55, ${p.opacity})`;
          ctx.beginPath();
          ctx.moveTo(0, -p.size * 1.5);
          ctx.quadraticCurveTo(p.size, 0, 0, p.size * 1.5);
          ctx.quadraticCurveTo(-p.size, 0, 0, -p.size * 1.5);
          ctx.fill();

          // Nervadura de la hoja
          ctx.strokeStyle = `rgba(235, 205, 110, ${p.opacity * 0.7})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        } else {
          // Destello dorado brillante estelar
          ctx.fillStyle = `rgba(212, 175, 55, ${p.opacity * 0.85})`;
          ctx.beginPath();
          ctx.arc(0, 0, p.size * 0.4, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx?.restore();
      }

      requestAnimationFrame(render);
    }

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloralAmbient);
  } else {
    initFloralAmbient();
  }
</script>
