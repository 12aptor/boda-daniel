---
// Hero 3D Canvas con Three.js
// Enfocado exclusivamente en una caída orgánica y etérea de pétalos botánicos en 3D
// Responde con suavidad al movimiento del mouse (viento e inercia) y al scroll del usuario.
---
<div id="hero-canvas-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
  <canvas id="three-hero-canvas" class="w-full h-full block opacity-0 transition-opacity duration-1000"></canvas>
</div>

<script>
  import * as THREE from 'three';

  function initHeroCanvas() {
    const container = document.getElementById('hero-canvas-container');
    const canvas = document.getElementById('three-hero-canvas') as HTMLCanvasElement;

    if (!container || !canvas) return;

    const width = window.innerWidth;
    const height = window.innerHeight;

    try {
      initThreeJs(container, canvas, width, height);
    } catch (err) {
      console.warn('Fallback a modo Canvas 2D:', err);
      init2DFallback(container, canvas);
    }
  }

  function initThreeJs(container: HTMLElement, canvas: HTMLCanvasElement, width: number, height: number) {
    // Escena principal
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0xFFFFFF, 0.002);

    // Cámara de perspectiva
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.set(0, 0, 80);

    // Renderizador WebGL
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;

    // Iluminación suave y natural
    const ambientLight = new THREE.AmbientLight(0xfff7ee, 1.6);
    scene.add(ambientLight);

    const sunLight = new THREE.DirectionalLight(0xfff0db, 1.8);
    sunLight.position.set(25, 45, 40);
    scene.add(sunLight);

    const rimLight = new THREE.DirectionalLight(0xd9e3f0, 0.8);
    rimLight.position.set(-25, -20, 30);
    scene.add(rimLight);

    // --- GEOMETRÍAS BOTÁNICAS 3D REALISTAS: HOJAS Y PÉTALOS DE ROSA ---
    const isMobile = window.innerWidth < 768;
    // Cantidad equilibrada: sutil y etérea, con presencia justa
    const petalCount = isMobile ? 34 : 48;
    const petalsGroup = new THREE.Group();
    scene.add(petalsGroup);

    // 1. Geometría 3D de Hoja Botánica (con peciolo y punta lanceolada afilada)
    const leafShape = new THREE.Shape();
    leafShape.moveTo(0, -2.5); // Tallo
    leafShape.lineTo(0.25, -1.0);
    leafShape.bezierCurveTo(2.8, 1.8, 2.5, 6.5, 0, 9.8); // Punta apical afilada
    leafShape.bezierCurveTo(-2.5, 6.5, -2.8, 1.8, -0.25, -1.0);
    leafShape.lineTo(0, -2.5);

    const leafGeom = new THREE.ShapeGeometry(leafShape, 16);
    const lPos = leafGeom.attributes.position;
    for (let i = 0; i < lPos.count; i++) {
      const y = lPos.getY(i);
      const x = lPos.getX(i);
      // Nervadura central 3D con cresta y curvatura longitudinal
      const spineRidge = (1 - Math.min(1, Math.abs(x) / 2.5)) * 0.9;
      const longitudinal = Math.sin(((y + 2.5) / 12.3) * Math.PI) * 1.3;
      lPos.setZ(i, spineRidge + longitudinal);
    }
    leafGeom.computeVertexNormals();

    // 2. Geometría 3D de Pétalo de Rosa (con hendidura de corazón y copa cóncava)
    const petalShape = new THREE.Shape();
    petalShape.moveTo(0, 0); // Base estrecha
    petalShape.bezierCurveTo(2.9, 2.8, 3.4, 6.2, 1.9, 9.2); // Lóbulo derecho
    petalShape.bezierCurveTo(1.0, 8.4, 0, 7.6, 0, 7.6); // Hendidura de corazón
    petalShape.bezierCurveTo(0, 7.6, -1.0, 8.4, -1.9, 9.2); // Hendidura a lóbulo izquierdo
    petalShape.bezierCurveTo(-3.4, 6.2, -2.9, 2.8, 0, 0);

    const petalGeom = new THREE.ShapeGeometry(petalShape, 16);
    const pPos = petalGeom.attributes.position;
    for (let i = 0; i < pPos.count; i++) {
      const y = pPos.getY(i);
      const x = pPos.getX(i);
      const cupping = Math.sin((y / 9.2) * Math.PI) * 1.5 - (x * x) * 0.14;
      pPos.setZ(i, cupping);
    }
    petalGeom.computeVertexNormals();

    // Paleta delicada de pétalos nupciales inspirada en la invitación (rosas azules, hojas de oro, marfil)
    const petalPalette = [
      0x5F86A6, // Rosa azul empolvado (dusty blue)
      0x8AA8C4, // Celeste periwinkle sutil
      0x1E3A66, // Azul marino profundo (navy rose)
      0xD4AF37, // Oro metálico (hoja dorada)
      0xFAF7F2, // Marfil floral puro
      0xEADBC5  // Champagne cálido
    ];

    interface PetalData {
      mesh: THREE.Mesh;
      rx: number;
      ry: number;
      rz: number;
      swaySpeed: number;
      swayOffset: number;
      fallSpeed: number;
      initialScale: number;
    }

    const petals: PetalData[] = [];

    for (let i = 0; i < petalCount; i++) {
      const color = petalPalette[Math.floor(Math.random() * petalPalette.length)];
      const isGold = color === 0xD4AF37;
      const isLeaf = isGold || Math.random() < 0.35;
      const selectedGeom = isLeaf ? leafGeom : petalGeom;

      const mat = new THREE.MeshStandardMaterial({
        color,
        roughness: isGold ? 0.3 : 0.65,
        metalness: isGold ? 0.8 : 0.05,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: isMobile ? 0.40 : 0.48
      });

      const mesh = new THREE.Mesh(selectedGeom, mat);

      // Tamaño sutil y armónico con presencia delicada
      const s = isMobile
        ? (Math.random() * 0.10 + 0.26)
        : (Math.random() * 0.16 + 0.38);

      mesh.scale.set(s, s, s);

      const posX = isMobile ? (Math.random() - 0.5) * 65 : (Math.random() - 0.5) * 150;
      const posY = (Math.random() - 0.5) * 140;
      const posZ = isMobile ? ((Math.random() - 0.5) * 30 - 15) : ((Math.random() - 0.5) * 70);

      mesh.position.set(posX, posY, posZ);

      mesh.rotation.set(
        Math.random() * Math.PI * 2,
        Math.random() * Math.PI * 2,
        Math.random() * Math.PI * 2
      );

      petalsGroup.add(mesh);
      petals.push({
        mesh,
        rx: (Math.random() - 0.5) * (isMobile ? 0.008 : 0.012),
        ry: (Math.random() - 0.5) * (isMobile ? 0.010 : 0.014),
        rz: (Math.random() - 0.5) * 0.008,
        swaySpeed: Math.random() * 0.015 + 0.006,
        swayOffset: Math.random() * Math.PI * 2,
        fallSpeed: isMobile ? (Math.random() * 0.025 + 0.015) : (Math.random() * 0.04 + 0.02),
        initialScale: s
      });
    }

    // --- INTERACTIVIDAD CON MOUSE (TOTALMENTE INDEPENDIENTE DEL SCROLL) ---
    let mouseX = 0, mouseY = 0;
    let targetMouseX = 0, targetMouseY = 0;

    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      let cx = 0, cy = 0;
      if ('touches' in e && e.touches.length > 0) {
        cx = e.touches[0].clientX;
        cy = e.touches[0].clientY;
      } else if ('clientX' in e) {
        cx = e.clientX;
        cy = e.clientY;
      }
      targetMouseX = (cx / window.innerWidth) * 2 - 1;
      targetMouseY = -(cy / window.innerHeight) * 2 + 1;
    };

    window.addEventListener('pointermove', onPointerMove, { passive: true });

    // Pausar solo si la pestaña está oculta para ahorrar batería/CPU
    let isTabVisible = !document.hidden;
    document.addEventListener('visibilitychange', () => {
      isTabVisible = !document.hidden;
    });

    const onResize = () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };
    window.addEventListener('resize', onResize);

    setTimeout(() => {
      canvas.classList.remove('opacity-0');
      canvas.classList.add('opacity-100');
    }, 150);

    const startTime = performance.now();

    const render = () => {
      requestAnimationFrame(render);
      if (!isTabVisible) return;

      const elapsed = (performance.now() - startTime) * 0.001;

      // Inercia suave del cursor únicamente (no afectado por scroll)
      mouseX += (targetMouseX - mouseX) * 0.04;
      mouseY += (targetMouseY - mouseY) * 0.04;

      // Movimiento sutil de cámara por mouse
      camera.position.x = mouseX * 8;
      camera.position.y = mouseY * 6;
      camera.lookAt(0, 0, 0);

      // ANIMACIÓN ORGÁNICA CONTINUA DE LOS PÉTALOS (CAÍDA CONSTANTE, SIN ALTERACIÓN POR SCROLL)
      petals.forEach(p => {
        // Giro tridimensional continuo
        p.mesh.rotation.x += p.rx;
        p.mesh.rotation.y += p.ry;
        p.mesh.rotation.z += p.rz;

        // Descenso uniforme e inalterado por el scroll
        p.mesh.position.y -= p.fallSpeed;
        p.mesh.position.x += Math.sin(elapsed * p.swaySpeed + p.swayOffset) * 0.08 + (mouseX * 0.03);

        // Reposicionar al llegar al límite inferior para un ciclo infinito y armonioso
        if (p.mesh.position.y < -70) {
          p.mesh.position.y = 70;
          p.mesh.position.x = isMobile ? (Math.random() - 0.5) * 65 : (Math.random() - 0.5) * 150;
          p.mesh.position.z = isMobile ? ((Math.random() - 0.5) * 30 - 15) : ((Math.random() - 0.5) * 70);
        }
      });

      renderer.render(scene, camera);
    };

    render();
  }

  // Fallback 2D de pétalos en caso de que WebGL esté restringido
  function init2DFallback(container: HTMLElement, canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = container.clientWidth || window.innerWidth);
    let height = (canvas.height = container.clientHeight || window.innerHeight);
    const isMobile2D = window.innerWidth < 768;

    window.addEventListener('resize', () => {
      width = canvas.width = container.clientWidth || window.innerWidth;
      height = canvas.height = container.clientHeight || window.innerHeight;
    });

    const petals2D: { x: number; y: number; size: number; speedY: number; speedX: number; rot: number; rotSpeed: number; color: string }[] = [];
    const colors = ['#FDFBF7', '#F7EFE5', '#EFE5D8', '#E2D7C5'];
    const count2D = isMobile2D ? 20 : 28;

    for (let i = 0; i < count2D; i++) {
      petals2D.push({
        x: Math.random() * width,
        y: Math.random() * height,
        // Tamaño uniforme y fino con presencia sutil
        size: isMobile2D ? (Math.random() * 2.0 + 3.2) : (Math.random() * 3.0 + 4.2),
        speedY: Math.random() * 0.35 + 0.15,
        speedX: (Math.random() - 0.5) * 0.2,
        rot: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.012,
        color: colors[Math.floor(Math.random() * colors.length)]
      });
    }

    setTimeout(() => {
      canvas.classList.remove('opacity-0');
      canvas.classList.add('opacity-100');
    }, 150);

    const animate2D = () => {
      ctx.clearRect(0, 0, width, height);

      petals2D.forEach(p => {
        p.y += p.speedY;
        p.x += p.speedX;
        p.rot += p.rotSpeed;

        if (p.y > height + 20) {
          p.y = -20;
          p.x = Math.random() * width;
        }

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = 0.40;

        // Dibujo botánico: hoja lanceolada con tallo o pétalo con hendidura de corazón
        const h = p.size * 1.8;
        const w = p.size * 1.1;

        ctx.beginPath();
        if (p.size % 2 > 1) {
          // Hoja botánica con peciolo y punta aguda
          ctx.moveTo(0, h);
          ctx.lineTo(0, h + p.size * 0.4);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(0, h);
          ctx.bezierCurveTo(w, h * 0.4, w * 0.9, -h * 0.3, 0, -h);
          ctx.bezierCurveTo(-w * 0.9, -h * 0.3, -w, h * 0.4, 0, h);
        } else {
          // Pétalo con hendidura de corazón
          ctx.moveTo(0, h);
          ctx.bezierCurveTo(w, h * 0.4, w * 0.9, -h * 0.5, w * 0.4, -h * 0.8);
          ctx.bezierCurveTo(w * 0.15, -h * 0.7, 0, -h * 0.5, 0, -h * 0.5);
          ctx.bezierCurveTo(0, -h * 0.5, -w * 0.15, -h * 0.7, -w * 0.4, -h * 0.8);
          ctx.bezierCurveTo(-w * 0.9, -h * 0.5, -w, h * 0.4, 0, h);
        }
        ctx.closePath();
        ctx.fill();
        ctx.restore();
      });

      requestAnimationFrame(animate2D);
    };

    animate2D();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCanvas);
  } else {
    initHeroCanvas();
  }
</script>
