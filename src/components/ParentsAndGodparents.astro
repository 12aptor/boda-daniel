---
// Sección de Padres de los Novios y Padrinos de Matrimonio
// Estilo Editorial de Alta Costura: anuncio formal de cortejo nupcial
---

<section id="padres-padrinos" class="py-24 px-4 sm:px-6 relative z-10 bg-transparent">
  <div class="max-w-5xl mx-auto">
    <!-- Encabezado con Caligrafía Dorada -->
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-[#0E1B33]/5 border border-[#D4AF37]/35 mb-4"
      >
        <span
          class="text-xs sm:text-sm uppercase tracking-[0.25em] text-[#0E1B33] font-semibold"
          >Con la Bendición de Nuestras Familias</span
        >
      </div>

      <h2
        class="font-editorial text-4xl sm:text-6xl md:text-7xl font-light text-[#0E1B33] tracking-wide mb-2"
      >
        Nuestros Padres y Padrinos
      </h2>

      <div class="h-[1px] w-16 bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent mx-auto mb-4"></div>

      <p
        class="font-editorial italic text-lg sm:text-xl text-[#5A6A85] max-w-2xl mx-auto font-light leading-relaxed"
      >
        "Con profundo amor, gratitud y el honor de contar con su bendición, guía y compañía en este nuevo capítulo de nuestras vidas."
      </p>
    </div>

    <!-- Grid de Tarjetas de Honor (3 columnas elegantes) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 max-w-5xl mx-auto">
      
      <!-- 1. Papás del Novio -->
      <div
        class="p-8 sm:p-10 rounded-3xl bg-white/95 invitation-frame shadow-lg text-center flex flex-col items-center justify-between group hover:shadow-xl transition-all duration-300"
      >
        <div class="w-full flex flex-col items-center">
          <!-- Insignia Circular en Oro Fino -->
          <div
            class="w-14 h-14 rounded-full bg-[#FCFBF7] border border-[#D4AF37]/50 text-[#D4AF37] flex items-center justify-center mb-5 shadow-xs ring-4 ring-[#D4AF37]/10 group-hover:scale-105 transition-transform"
          >
            <svg class="w-6 h-6 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="12" r="5" />
              <circle cx="15" cy="12" r="5" />
            </svg>
          </div>

          <span
            class="text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-[#0E1B33] bg-[#0E1B33]/5 border border-[#D4AF37]/40 px-5 py-2 rounded-full mb-6"
          >
            Papás del Novio
          </span>

          <div class="space-y-3 w-full">
            <p class="font-editorial text-2xl sm:text-3xl font-normal text-[#0E1B33] tracking-wide">
              Rober Calle Altamirano
            </p>
            <div class="flex items-center justify-center">
              <span class="h-[1px] w-12 bg-gradient-to-r from-transparent via-[#D4AF37]/50 to-transparent"></span>
            </div>
            <p class="font-editorial text-2xl sm:text-3xl font-normal text-[#0E1B33] tracking-wide">
              Yovany Cuchillo Motocanchi
            </p>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-[#D4AF37]/25 text-xs sm:text-sm text-[#5A6A85] tracking-[0.18em] uppercase font-semibold">
          Familia Calle Cuchillo
        </div>
      </div>

      <!-- 2. Papás de la Novia -->
      <div
        class="p-8 sm:p-10 rounded-3xl bg-white/95 invitation-frame shadow-lg text-center flex flex-col items-center justify-between group hover:shadow-xl transition-all duration-300"
      >
        <div class="w-full flex flex-col items-center">
          <!-- Insignia Circular en Oro Fino -->
          <div
            class="w-14 h-14 rounded-full bg-[#FCFBF7] border border-[#D4AF37]/50 text-[#D4AF37] flex items-center justify-center mb-5 shadow-xs ring-4 ring-[#D4AF37]/10 group-hover:scale-105 transition-transform"
          >
            <svg class="w-6 h-6 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22v-8m0 0a4 4 0 0 1 4-4c0-2-2-4-4-4s-4 2-4 4a4 4 0 0 1 4 4z" />
              <path d="M12 14c-3 0-5 2-6 5" />
              <path d="M12 17c3 0 5 1.5 6 4" />
            </svg>
          </div>

          <span
            class="text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-[#0E1B33] bg-[#0E1B33]/5 border border-[#D4AF37]/40 px-5 py-2 rounded-full mb-6"
          >
            Papás de la Novia
          </span>

          <div class="space-y-3 w-full">
            <p class="font-editorial text-2xl sm:text-3xl font-normal text-[#0E1B33] tracking-wide">
              Isaac Chatata Alcca
            </p>
            <div class="flex items-center justify-center">
              <span class="h-[1px] w-12 bg-gradient-to-r from-transparent via-[#D4AF37]/50 to-transparent"></span>
            </div>
            <p class="font-editorial text-2xl sm:text-3xl font-normal text-[#0E1B33] tracking-wide">
              Hilda Cuyo Mamani
            </p>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-[#D4AF37]/25 text-xs sm:text-sm text-[#5A6A85] tracking-[0.18em] uppercase font-semibold">
          Familia Chatata Cuyo
        </div>
      </div>

      <!-- 3. Padrinos de Matrimonio -->
      <div
        class="p-8 sm:p-10 rounded-3xl bg-white/95 invitation-frame shadow-lg text-center flex flex-col items-center justify-between group hover:shadow-xl transition-all duration-300 md:col-span-1"
      >
        <div class="w-full flex flex-col items-center">
          <!-- Insignia Circular en Oro Fino -->
          <div
            class="w-14 h-14 rounded-full bg-[#FCFBF7] border border-[#D4AF37]/50 text-[#D4AF37] flex items-center justify-center mb-5 shadow-xs ring-4 ring-[#D4AF37]/10 group-hover:scale-105 transition-transform"
          >
            <svg class="w-6 h-6 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" />
            </svg>
          </div>

          <span
            class="text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-[#0E1B33] bg-[#0E1B33]/5 border border-[#D4AF37]/40 px-5 py-2 rounded-full mb-6"
          >
            Nuestros Padrinos
          </span>

          <div class="space-y-3 w-full">
            <p class="font-editorial text-2xl sm:text-3xl font-normal text-[#0E1B33] tracking-wide">
              Jose Luis Ramirez Granilla
            </p>
            <div class="flex items-center justify-center">
              <span class="h-[1px] w-12 bg-gradient-to-r from-transparent via-[#D4AF37]/50 to-transparent"></span>
            </div>
            <p class="font-editorial text-2xl sm:text-3xl font-normal text-[#0E1B33] tracking-wide">
              Deny Lidelma Torres Champi
            </p>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-[#D4AF37]/25 text-xs sm:text-sm text-[#5A6A85] tracking-[0.18em] uppercase font-semibold">
          Padrinos de Boda
        </div>
      </div>

    </div>

    <!-- Cita de Cierre de Honor -->
    <div class="mt-14 text-center">
      <div class="inline-flex items-center gap-3 text-xs sm:text-sm uppercase tracking-[0.25em] text-[#917238] font-medium">
        <span>✦</span>
        <span>Unidos por el Amor y la Familia</span>
        <span>✦</span>
      </div>
    </div>
  </div>
</section>
